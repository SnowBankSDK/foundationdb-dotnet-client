<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Throwaway project that compiles the code samples from the .claude/skills/* docs
		against the live FoundationDB.Client, to guarantee the examples are accurate.
		It is NOT part of FoundationDB.Client.slnx. Build with:
		    dotnet build samples/SkillValidation/SkillValidation.csproj
	-->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<IsPackable>false</IsPackable>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\FoundationDB.Client\FoundationDB.Client.csproj" />
	</ItemGroup>

</Project>
