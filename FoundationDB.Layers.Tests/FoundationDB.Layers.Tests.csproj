<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Microsoft.Testing.Platform runner (like the other test projects): the test assembly is a self-contained
		     executable, run directly with `dotnet <dll>` (plus the usual filter options) instead of `dotnet test` -->
		<OutputType>Exe</OutputType>
		<!-- modern targets only: this suite references FoundationDB.FakeDb unconditionally (every layer suite
		     runs against the in-memory backend first), and that emulator has no netstandard2.0 build for a
		     net472 leg to consume -->
		<TargetFrameworks>$(CoreSdkRuntimeVersions)</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Common\foundationdb-net-client.snk</AssemblyOriginatorKeyFile>
		<DelaySign>false</DelaySign>
	</PropertyGroup>

	<Import Project="..\Common\VersionInfo.props" />

	<PropertyGroup>
		<IsTestProject>true</IsTestProject>
		<EnableNUnitRunner>true</EnableNUnitRunner>
		<IsPackable>false</IsPackable>
		<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
	</PropertyGroup>

	<PropertyGroup>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
		<PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NUnit3TestAdapter">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- real-cluster fixtures ([Category("RealCluster")]) provision a FoundationDB container through FdbTest -->
		<PackageReference Include="Testcontainers" />
		<!-- the Experimental/Documents suite exercises a protobuf-net based document codec -->
		<PackageReference Include="protobuf-net" />
		<!-- the Experimental/Indexing bitmap suite uses MathNet distributions to generate test data -->
		<PackageReference Include="MathNet.Numerics.Signed" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SnowBank.Testing.Common\SnowBank.Testing.Common.csproj" />
		<ProjectReference Include="..\FoundationDB.Client\FoundationDB.Client.csproj" />
		<ProjectReference Include="..\FoundationDB.FakeDb\FoundationDB.FakeDb.csproj" />
		<ProjectReference Include="..\FoundationDB.Layers.Common\FoundationDB.Layers.Common.csproj" />
		<ProjectReference Include="..\FoundationDB.Layers.Experimental\FoundationDB.Layers.Experimental.csproj" />
		<ProjectReference Include="..\FoundationDB.Testing\FoundationDB.Testing.csproj" />
		<ProjectReference Include="..\FoundationDB.Client.Native\FoundationDB.Client.Native.csproj" />
	</ItemGroup>

	<!-- Copies the native fdb_c client next to the test assembly so the real-cluster fixtures can locate it -->
	<Import Project="..\FoundationDB.Client.Native\build\FoundationDB.Client.Native.targets" />

</Project>
