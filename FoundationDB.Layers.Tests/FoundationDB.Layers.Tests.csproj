<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Microsoft.Testing.Platform runner (like the other test projects): the test assembly is a self-contained
		     executable, run directly with `dotnet <dll>` (plus the usual filter options) instead of `dotnet test` -->
		<OutputType>Exe</OutputType>
		<TargetFrameworks>$(CoreSdkRuntimeVersions)</TargetFrameworks>
		<!-- the net472 validation target consumes the netstandard2.0 builds of the layer libraries; layers with no
		     netstandard2.0 build (Layers.Experimental) have their test folders removed on net472 (see below) -->
		<TargetFrameworks Condition="'$(CoreSdkNetStandardEnabled)' == 'true'">$(TargetFrameworks);net472</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<IsTestProject>true</IsTestProject>
		<EnableNUnitRunner>true</EnableNUnitRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
		<IsPackable>false</IsPackable>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Common\foundationdb-net-client.snk</AssemblyOriginatorKeyFile>
		<DelaySign>false</DelaySign>
	</PropertyGroup>

	<Import Project="..\Common\VersionInfo.props" />

	<PropertyGroup>
		<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
	</PropertyGroup>

	<PropertyGroup>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
		<PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NUnit3TestAdapter">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- real-cluster fixtures ([Category("RealCluster")]) provision a FoundationDB container through FdbTest -->
		<PackageReference Include="Testcontainers" />
		<!-- the Experimental/Documents suite exercises a protobuf-net based document codec -->
		<PackageReference Include="protobuf-net" />
		<!-- the Experimental/Indexing bitmap suite uses MathNet distributions to generate test data -->
		<PackageReference Include="MathNet.Numerics.Signed" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
		<!-- nullable-flow false positives: the .NET Framework BCL lacks the nullable annotations the modern BCL carries -->
		<NoWarn>$(NoWarn);CS8602;CS8603;CS8604;CS8767;CS8769;CS8777</NoWarn>
		<!-- the CoreSDK is x64-only (the FoundationDB native client has no 32-bit build) -->
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<!-- layers with no netstandard2.0/net472 build: their test folders are removed on net472 (also guarded with #if !NETFRAMEWORK) -->
		<Compile Remove="FullText/**/*.cs" />
		<Compile Remove="Experimental/**/*.cs" />
		<Reference Include="System.Net.Http" />
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
		<PackageReference Include="PolySharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
		<!-- direct reference so that the binding redirect to 2.2.3 is auto-generated (the NUnit adapter requests 2.1.0) -->
		<PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SnowBank.Testing.Common\SnowBank.Testing.Common.csproj" />
		<ProjectReference Include="..\FoundationDB.Client\FoundationDB.Client.csproj" />
		<ProjectReference Include="..\FoundationDB.FakeDb\FoundationDB.FakeDb.csproj" />
		<ProjectReference Include="..\FoundationDB.Layers.Common\FoundationDB.Layers.Common.csproj" />
		<ProjectReference Include="..\FoundationDB.Testing\FoundationDB.Testing.csproj" />
		<ProjectReference Include="..\FoundationDB.Client.Native\FoundationDB.Client.Native.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net472'">
		<!-- Layers.Experimental has no netstandard2.0/net472 build: its test files are guarded with #if !NETFRAMEWORK -->
		<ProjectReference Include="..\FoundationDB.Layers.Experimental\FoundationDB.Layers.Experimental.csproj" />
	</ItemGroup>

	<!-- Copies the native fdb_c client next to the test assembly so the real-cluster fixtures can locate it -->
	<Import Project="..\FoundationDB.Client.Native\build\FoundationDB.Client.Native.targets" />

</Project>
