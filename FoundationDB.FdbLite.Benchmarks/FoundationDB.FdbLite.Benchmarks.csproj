<Project Sdk="Microsoft.NET.Sdk">

	<!--
		BenchmarkDotNet suites for the FdbLite storage engine: file-store geometry and thermal tiers (cold, restart, hot),
		durability (flush cost), committed-store scans, and the cache-cliff chunk log. Recipes: README.md.
		The correctness checks and the cross-run comparison live in FoundationDB.FdbLite.Bench.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>$(CoreSdkStorageVersions)</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<IsPackable>false</IsPackable>
		<IsTestProject>false</IsTestProject>
		<GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Common\foundationdb-net-client.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<Import Project="..\Common\VersionInfo.props" />

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SnowBank.Core\SnowBank.Core.csproj" />
		<ProjectReference Include="..\FoundationDB.FakeDb\FoundationDB.FakeDb.csproj" />
		<ProjectReference Include="..\FoundationDB.FdbLite\FoundationDB.FdbLite.csproj" />
	</ItemGroup>

</Project>
