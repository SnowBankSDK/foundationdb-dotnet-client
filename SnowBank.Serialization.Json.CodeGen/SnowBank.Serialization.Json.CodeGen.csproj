<Project Sdk="Microsoft.NET.Sdk">

	<!-- The roslyn5.9 build of the generator, and the project that packs both builds. In-repo projects reference this one. -->
	<PropertyGroup>
		<JsonCodeGenRoslynVersion>5.9</JsonCodeGenRoslynVersion>
	</PropertyGroup>

	<Import Project="SnowBank.Serialization.Json.CodeGen.Build.props" />

	<PropertyGroup>
		<AssemblyTitle>SnowBank JSON Code Generator</AssemblyTitle>
		<Description>Generates optimized code for custom JSON serializers and proxies</Description>
		<PackageTags>snowbank sdk json codegen</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>snowbank.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../Common/snowbank.png" Pack="true" Visible="false" PackagePath="\" />
		<None Include="./README.md" Pack="true" Visible="false" PackagePath="\" />
	</ItemGroup>

	<!-- The roslyn4.12 build, packed next to this one -->
	<ItemGroup>
		<ProjectReference Include="..\SnowBank.Serialization.Json.CodeGen.Roslyn4.12\SnowBank.Serialization.Json.CodeGen.Roslyn4.12.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!-- For redistributing a source generator as a nuget package, we need to manually change a few things: -->
	<!-- 1) Each build goes under 'analyzers/dotnet/roslynX.Y/cs'. The one that runs has the highest X.Y that is not newer than the
	        running compiler. Below Roslyn 4.12 none runs, and the build reports no CS8032. The unversioned 'analyzers/dotnet/cs'
	        stays empty: an assembly there would run on every compiler, next to the versioned build. -->
	<!-- 2) We need to set IncludeBuildOutput to false, otherwise it will also copy the dll in the 'lib/' folder, even though it is not supposed to be published alongside the consuming application.-->
	<PropertyGroup>
		<!-- Do not include the dll in the 'lib/' folder -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- Do not include the Roslyn dependencies either -->
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
	</ItemGroup>

	<Target Name="AddRoslyn412GeneratorToPackage" BeforeTargets="_GetPackageFiles">
		<MSBuild Projects="..\SnowBank.Serialization.Json.CodeGen.Roslyn4.12\SnowBank.Serialization.Json.CodeGen.Roslyn4.12.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
			<Output TaskParameter="TargetOutputs" ItemName="_JsonCodeGenRoslyn412Assembly" />
		</MSBuild>
		<ItemGroup>
			<None Include="@(_JsonCodeGenRoslyn412Assembly)" Pack="true" PackagePath="analyzers/dotnet/roslyn4.12/cs" Visible="false" />
		</ItemGroup>
	</Target>

</Project>
