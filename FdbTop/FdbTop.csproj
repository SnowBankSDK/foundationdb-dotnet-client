<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>$(CoreSdkToolsVersions)</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<InvariantGlobalization>true</InvariantGlobalization>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Common\foundationdb-net-client.snk</AssemblyOriginatorKeyFile>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<RollForward>Major</RollForward>
		<!-- Pack as a platform-specific tool: one sub-package per RID (with only that platform's fdb_c) plus a top-level manifest package; requires the .NET 10+ SDK to install -->
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
		<!-- The tool sub-packages are framework-dependent: the .NET 10+ SDK is required to install/run them anyway, and bundling the runtime would triple the size of each package (can still be overridden by publishing as self-contained from the command line) -->
		<SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
		<!-- Publish as a single-file executable, both for 'dotnet publish -r <rid>' and for the per-RID inner publish performed when packing the tool (the bundled fdb_c native library stays next to the executable) -->
		<PublishSingleFile Condition="'$(PublishSingleFile)' == '' AND ('$(_IsPublishing)' == 'true' OR '$(RuntimeIdentifier)' != '')">true</PublishSingleFile>
		<!-- Trimming is only possible when explicitly publishing as self-contained -->
		<PublishTrimmed Condition="'$(PublishTrimmed)' == '' AND '$(_IsPublishing)' == 'true' AND '$(SelfContained)' == 'true'">true</PublishTrimmed>
		<!-- Do not ship the XML documentation of the referenced libraries with the tool -->
		<PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
		<TrimmerRootAssembly>FoundationDB.Client</TrimmerRootAssembly>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<Import Project="..\Common\VersionInfo.props" />

	<PropertyGroup>
		<AssemblyTitle>FdbTop</AssemblyTitle>
		<Description>Command line tool for monitoring a live FoundationDB cluster.</Description>
		<PackageTags>foundationdb fdb nosql fdbtop tool</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>foundationdb.png</PackageIcon>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>fdbtop</ToolCommandName>
	</PropertyGroup>

	<!-- Packing the tool requires the pre-downloaded fdb_c native libraries, which may not be possible in all CI (same convention as FoundationDB.Client.Native) -->
	<PropertyGroup Condition="'$(DISABLE_NATIVE_PACKAGE)' == 'true'">
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../Common/foundationdb.png" Pack="true" Visible="false" PackagePath="\" />
		<None Include="./README.md" Pack="true" Visible="false" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FoundationDB.Client\FoundationDB.Client.csproj" />
		<ProjectReference Include="..\FoundationDB.Client.Native\FoundationDB.Client.Native.csproj" />
	</ItemGroup>

	<Import Project="..\FoundationDB.Client.Native\build\FoundationDB.Client.Native.targets" />

</Project>
