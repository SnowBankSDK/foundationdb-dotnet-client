<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFrameworks>$(CoreSdkRuntimeVersions)</TargetFrameworks>
		<TargetFrameworks Condition="'$(CoreSdkNetStandardEnabled)' == 'true'">$(TargetFrameworks);netstandard2.0</TargetFrameworks>
		<AssemblyName>FoundationDB.Client.Native</AssemblyName>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Common\foundationdb-net-client.snk</AssemblyOriginatorKeyFile>
		<Deterministic>true</Deterministic>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<!--<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>-->
		<!-- Define the platforms that we support -->
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64;osx-x64</RuntimeIdentifiers>
	</PropertyGroup>
	
	<Import Project="..\Common\VersionInfo.props" />

	<PropertyGroup>
		<!-- The package version follows the native FoundationDB version it ships, NOT the .NET binding.
		     FdbNativeVersion names the manifest.json entry whose files DownloadBinaries fetched into runtimes\.
		     Default: the manifest's "latest" (the first version string of the file, "latest" being its first key).
		     One branch at a time: dotnet pack -p:FdbNativeVersion=7.3.78 after DownloadBinaries.ps1 -version 7.3.78. -->
		<FdbNativeManifest>$(MSBuildThisFileDirectory)manifest.json</FdbNativeManifest>
		<FdbNativeVersion Condition="'$(FdbNativeVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(FdbNativeManifest)')), '[0-9]+\.[0-9]+\.[0-9]+').Value)</FdbNativeVersion>
		<VersionPrefix>$(FdbNativeVersion)</VersionPrefix>
		<VersionSuffix></VersionSuffix>
		<AssemblyTitle>Native Client Libraries for FoundationDB</AssemblyTitle>
		<Description>FoundationDB Native Client libraries for Windows (fdb_c.dll), Linux (libfdb_c.so) and macOS (libfdb_c.dylib).</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>foundationdb.png</PackageIcon>
		<IsPackable>true</IsPackable>
	</PropertyGroup>
	
	<!-- Building the native packages requires pre-downloading some files, which may not be possible in all CI -->
	<PropertyGroup Condition="'$(DISABLE_NATIVE_PACKAGE)' == 'true'">
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	
	<!-- Detect if we are being packed as part of another package -->
	<PropertyGroup>
		<IsPackingSelf Condition="'$(IsPackable)' == 'true' and '$(_IsPacking)' == 'true' and '$(MSBuildProjectName)' == 'FoundationDB.Client.Native'">true</IsPackingSelf>
		<IsPackingSelf Condition="'$(IsPackingSelf)' == ''">false</IsPackingSelf>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsPackingSelf)' != 'true'">
		<!-- Reference FoundationDB.Client either as a direct project reference, or via NuGet -->
		<ProjectReference Include="..\FoundationDB.Client\FoundationDB.Client.csproj" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(IsPackingSelf)' == 'true'">
		<!-- Reference FoundationDB.Client via NuGet with an open-ended range: this package only adds the native
		     libraries (and a small helper), and the binding's version is no longer tied to the cluster version
		     (8.x, 9.x binding releases will follow). The floor is 7.4.1, the first version with a netstandard2.0
		     target; no upper bound, so a future major of the binding keeps loading these packages. -->
		<PackageReference Include="FoundationDB.Client" VersionOverride="7.4.1" />
		<!-- Exclude the other dependencies to prevent them from appearing in the .nuspec -->
		<!-- How to update: comment all of them, rebuild the package, inspect the .nuspec, and re-add the deps that have appeared (only keep FoundationDB.Client) -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" ExcludeAssets="All" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" ExcludeAssets="All" />
		<PackageReference Include="Microsoft.Extensions.Options" ExcludeAssets="All" />
		<PackageReference Include="NodaTime" ExcludeAssets="All" />
		<PackageReference Include="OpenTelemetry.Api" ExcludeAssets="All" />
		<PackageReference Include="System.IO.Pipelines" ExcludeAssets="All" />
		<!-- these are pulled by the netstandard2.0 build of FoundationDB.Client/SnowBank.Core -->
		<PackageReference Include="Microsoft.Bcl.HashCode" ExcludeAssets="All" />
		<PackageReference Include="System.Collections.Immutable" ExcludeAssets="All" />
		<PackageReference Include="System.IO.Hashing" ExcludeAssets="All" />
		<PackageReference Include="System.Memory" ExcludeAssets="All" />
		<PackageReference Include="System.Threading.Channels" ExcludeAssets="All" />
		<!-- these two are in-box on net8+ and only pulled by the netstandard2.0 build, where their PackageVersion is defined; referencing them on net8/10/11 has no central version (NU1010) -->
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" ExcludeAssets="All" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" ExcludeAssets="All" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
	</ItemGroup>

	<!-- Include all the native libraries and tools -->
	<ItemGroup>

		<!-- Readme and icons for the NuGet Package -->
		<None Include="../Common/foundationdb.png" Pack="true" Visible="false" PackagePath="\" />
		<None Include="./README.md" Pack="true" Visible="false" PackagePath="\" />

		<!-- Include the .targets file in the package -->
		<None Include="build\FoundationDB.Client.Native.targets" Pack="true" PackagePath="build/" />

		<!-- Windows x64 -->
		<None Include="runtimes\win-x64\native\fdb_c.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />

		<!-- Linux x64 -->
		<None Include="runtimes\linux-x64\native\libfdb_c.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />

		<!-- Linux arm64 -->
		<None Include="runtimes\linux-arm64\native\libfdb_c.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />

		<!-- macOS arm64 -->
		<None Include="runtimes\osx-arm64\native\libfdb_c.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />

		<!-- macOS x64 -->
		<None Include="runtimes\osx-x64\native\libfdb_c.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />

	</ItemGroup>

	<!-- The files under runtimes\ must belong to $(FdbNativeVersion). DownloadBinaries writes the version it fetched into
	     runtimes\fdb-native-version.txt; a pack whose stamp is missing or names another version stops here. -->
	<Target Name="CheckFdbNativeVersionStamp" BeforeTargets="GenerateNuspec" Condition="'$(IsPackingSelf)' == 'true'">
		<PropertyGroup>
			<FdbNativeStampFile>$(MSBuildThisFileDirectory)runtimes\fdb-native-version.txt</FdbNativeStampFile>
			<FdbNativeStamp Condition="Exists('$(FdbNativeStampFile)')">$([System.IO.File]::ReadAllText('$(FdbNativeStampFile)').Trim())</FdbNativeStamp>
		</PropertyGroup>
		<Error Condition="'$(FdbNativeStamp)' == ''" Text="runtimes\ carries no version stamp: run DownloadBinaries.ps1 -version $(FdbNativeVersion) (or DownloadBinaries.sh --version $(FdbNativeVersion)) before packing." />
		<Error Condition="'$(FdbNativeStamp)' != '' and '$(FdbNativeStamp)' != '$(FdbNativeVersion)'" Text="runtimes\ holds the native libraries of $(FdbNativeStamp) but the package version is $(FdbNativeVersion): run DownloadBinaries.ps1 -version $(FdbNativeVersion) first, or pack with -p:FdbNativeVersion=$(FdbNativeStamp)." />
		<Message Importance="high" Text="FoundationDB.Client.Native $(FdbNativeVersion): the runtimes\ stamp matches." />
	</Target>

</Project>