<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<!-- follows the emulator that consumes it: a leg cannot reference a project that does not build for it,
		     and the emulator resolves this macro to net11.0;net10.0 under a parent and adds net8.0 standalone -->
		<TargetFrameworks>$(CoreSdkStorageVersions)</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Common\foundationdb-net-client.snk</AssemblyOriginatorKeyFile>
		<Deterministic>true</Deterministic>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
	</PropertyGroup>

	<Import Project="..\Common\VersionInfo.props" />

	<PropertyGroup>
		<AssemblyTitle>FoundationDB FdbLite Local Store</AssemblyTitle>
		<Description>Single-process, on-disk key/value store that speaks the FoundationDB transaction API without a cluster: a memory-mapped copy-on-write B+tree file (or an in-memory store) for edge nodes, local tools and tests</Description>
		<PackageTags>foundationdb fdb nosql database snowbank sdk embedded local storage edge</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>foundationdb.png</PackageIcon>
		<GenerateDocumentationFile Condition="'$(Configuration)' != 'Debug'">true</GenerateDocumentationFile>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../Common/foundationdb.png" Pack="true" Visible="false" PackagePath="\" />
		<None Include="./README.md" Pack="true" Visible="false" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.IO.Hashing" />
	</ItemGroup>

	<!-- spans over pages and pooled buffers only: this project knows nothing about the emulator that hosts it -->
	<ItemGroup>
		<ProjectReference Include="..\SnowBank.Core\SnowBank.Core.csproj" />
		<ProjectReference Include="..\FoundationDB.Client\FoundationDB.Client.csproj" />
	</ItemGroup>

</Project>
