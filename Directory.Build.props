<Project>

	<!-- Detect if we are used as a submodule in a parent repository, and if this is true, try to import the parent Directory.Build.props folder that could override the properties defined here -->
	<!-- We use the fact that git-submodules have a .git _file_, instead of a .git _directory_, which can help prevent from an attacker somehow being able to inject a fake .props file above us -->
	<!-- If this heuristic does not work, this can be worked around by setting the FDB_BUILD_PROPS_OVERRIDE env variable to a non-empty value -->
	<!-- Set CORESDK_STANDALONE_BUILD=true to FORCE a standalone build that ignores the parent overrides entirely and restores this repo's own complete target set (net11.0;net10.0;net8.0 + netstandard2.0). Required when packing a release: a parent that trims targets (e.g. to net10/net11 only) would otherwise ship an INCOMPLETE .nupkg. Also use it when building/testing this repo on its own inside such a parent, to catch net8.0 / netstandard2.0-only issues a target-trimming parent would hide. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
	        Condition="'$(CORESDK_STANDALONE_BUILD)' != 'true' AND Exists('$(MSBuildThisFileDirectory)../Directory.Build.props') AND ($([System.IO.File]::Exists('$(MSBuildThisFileDirectory)/.git')) OR '$(FDB_BUILD_PROPS_OVERRIDE)' != '')" />

	<PropertyGroup>
		<!-- All projects will build/pack/publish under "artifacts/*" -->
		<ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
		<!-- Enable GlobalUsings.cs for all projects -->
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Embed symbols in the assembly -->
		<DebugType>embedded</DebugType>

		<!-- Silences the .NET SDK preview message/banner (NETSDK1057) -->
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
	</PropertyGroup>

	<!-- Enable Runtime Async by default on .NET 11+ -->
	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
		<Features>$(Features);runtime-async=on</Features>
	</PropertyGroup>

	<!--
		These settings are used by all other projects to define the build target.
		When this repository is included as a submodule, the parent folder can override these values
		in its own Directory.Build.props file, in order to not have to build extra targets that are not used.
	-->
	<PropertyGroup>
		
		<!-- The 'CoreSdkVersions' variable can be used to override all the versions at once! -->
		
		<!-- Framework versions for the core libraries (Core, FoundationDb.Client, ...) -->
		<CoreSdkRuntimeVersions Condition="'$(CoreSdkRuntimeVersions)' == ''">$(CoreSdkVersions)</CoreSdkRuntimeVersions>
		<CoreSdkRuntimeVersions Condition="'$(CoreSdkRuntimeVersions)' == ''">net11.0;net10.0;net8.0</CoreSdkRuntimeVersions>
		
		<!-- Framework versions for tools that are packed (FdbTop, FdbShell, ...) -->
		<!-- Single TFM by default: these are packed as platform-specific tool packages (one sub-package per RID), which require the .NET 10+ SDK to install anyway, and every extra TFM would inflate all the RID sub-packages -->
		<CoreSdkToolsVersions Condition="'$(CoreSdkToolsVersions)' == ''">$(CoreSdkVersions)</CoreSdkToolsVersions>
		<CoreSdkToolsVersions Condition="'$(CoreSdkToolsVersions)' == ''">net10.0</CoreSdkToolsVersions>
		
		<!-- Framework versions for local tools that are not packed (FdbBurner, Sandboxes, ...) -->
		<CoreSdkUtilityVersions Condition="'$(CoreSdkUtilityVersions)' == ''">$(CoreSdkVersions)</CoreSdkUtilityVersions>
		<CoreSdkUtilityVersions Condition="'$(CoreSdkUtilityVersions)' == ''">net10.0</CoreSdkUtilityVersions>
		
		<!-- Framework versions for Aspire (only .NET8+) -->
		<CloudSdkRuntimeVersions Condition="'$(CloudSdkRuntimeVersions)' == ''">$(CoreSdkVersions)</CloudSdkRuntimeVersions>
		<CloudSdkRuntimeVersions Condition="'$(CloudSdkRuntimeVersions)' == ''">net11.0;net10.0;net8.0</CloudSdkRuntimeVersions>

		<!-- Should we also build the core Compat library using netstandard2.0? -->
		<CoreSdkNetStandardEnabled Condition="'$(CoreSdkNetStandardEnabled)' == ''">true</CoreSdkNetStandardEnabled>

	</PropertyGroup>

	<!-- net472 is a deliberate ".NET Framework validation" stopgap, only present when CoreSdkNetStandardEnabled
	     adds it. Some test-only Microsoft.Extensions.* packages (e.g. Microsoft.Extensions.TimeProvider.Testing)
	     ship a net462 asset but emit a "not tested on net472" advisory. They work here (the net472 suites run on
	     the real .NET Framework CLR and are green), so the advisory is just noise: silence the TFM-support
	     warnings for this target. Scoped to net472, so a parent that disables netstandard2.0/net472 never sees it. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<!-- On the netstandard2.0/net472 "lite" targets, XML doc <see cref="..."/> comments that reference BCL
	     APIs newer than those frameworks (Stopwatch.GetElapsedTime, INumberBase&lt;T&gt;, Stream.DisposeAsync,
	     StringBuilder.AppendInterpolatedStringHandler, static abstract interface members, ...) cannot be
	     resolved and raise CS1574/CS1580. Those comments are correct for the modern targets, where the same
	     crefs DO resolve and stay checked (a genuinely broken cref, like one pointing at a member that exists
	     on no target, still fails there), so silence only the unresolvable-on-lite noise. Scoped to the lite
	     TFMs, so a parent that disables netstandard2.0/net472 never sees it. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net472'">
		<NoWarn>$(NoWarn);CS1574;CS1580</NoWarn>
	</PropertyGroup>

	<!-- Release builds turn on GenerateDocumentationFile, which raises CS1591 (missing XML doc comment) for every
	     undocumented public member. Until the public API is fully documented in a dedicated sweep (tracked separately),
	     that is pure noise on every Release build; silence it here. Remove this to drive the documentation sweep. -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

</Project>
