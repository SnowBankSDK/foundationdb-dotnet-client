<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFrameworks>$(CoreSdkRuntimeVersions)</TargetFrameworks>
		<!-- the net472 validation target consumes the netstandard2.0 build of SnowBank.Core, so it follows the same switch -->
		<TargetFrameworks Condition="'$(CoreSdkNetStandardEnabled)' == 'true'">$(TargetFrameworks);net472</TargetFrameworks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>enable</ImplicitUsings>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Common\foundationdb-net-client.snk</AssemblyOriginatorKeyFile>
		<Deterministic>true</Deterministic>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
	</PropertyGroup>

	<Import Project="..\Common\VersionInfo.props" />

	<PropertyGroup>
		<AssemblyTitle>SnowBank Testing SDK</AssemblyTitle>
		<Description>Library for writing NUnit tests with the SnowBank SDK</Description>
		<PackageTags>snowbank sdk nunit test testing tdd</PackageTags>
		<!--<PackageReadmeFile>README.md</PackageReadmeFile>-->
		<PackageIcon>snowbank.png</PackageIcon>
		<GenerateDocumentationFile Condition="'$(Configuration)' != 'Debug'">true</GenerateDocumentationFile>
		<IsPackable>true</IsPackable> <!-- must be forced to true, otherwise 'dotnet pack' does nothing on this project, for some reason... ? -->
	</PropertyGroup>

	<ItemGroup>
		<None Include="../Common/snowbank.png" Pack="true" Visible="false" PackagePath="\" />
		<!--<None Include="./README.md" Pack="true" Visible="false" PackagePath="\" />-->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NodaTime.Testing" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit.Console" />
		<PackageReference Include="NUnit.ConsoleRunner" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
		<!-- nullable-flow false positives: the .NET Framework BCL lacks the nullable annotations the modern BCL
		     carries (same family as SnowBank.Core's netstandard2.0 target) -->
		<NoWarn>$(NoWarn);CS8602;CS8603;CS8604;CS8767;CS8769;CS8777</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<!-- net472 is the ".NET Framework validation" target: it consumes the netstandard2.0 build of SnowBank.Core
		     and runs the test suite on the real .NET Framework CLR. The virtual-network test infrastructure depends
		     on SnowBank.Networking.Http, which has no netstandard2.0 build, so it is not part of this target. -->
		<Compile Remove="Network/**/*.cs" />
		<!-- WarmupOnceAttribute uses static abstract interface members, which .NET Framework cannot represent -->
		<Compile Remove="WarmupOnceAttribute.cs" />
		<Reference Include="System.Net.Http" />
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
		<PackageReference Include="PolySharp" PrivateAssets="all" />
		<!-- must match the version required by the Microsoft.Extensions.* 10.x packages resolved for this target -->
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SnowBank.Core\SnowBank.Core.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net6.0' and '$(TargetFramework)' != 'net472'">
		<ProjectReference Include="..\SnowBank.Networking.Http\SnowBank.Networking.Http.csproj" />
	</ItemGroup>

</Project>
