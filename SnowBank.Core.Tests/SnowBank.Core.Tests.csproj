<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>$(CoreSdkRuntimeVersions)</TargetFrameworks>
		<!-- the net472 validation target consumes the netstandard2.0 build of SnowBank.Core, so it follows the same switch -->
		<TargetFrameworks Condition="'$(CoreSdkNetStandardEnabled)' == 'true'">$(TargetFrameworks);net472</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	</PropertyGroup>

	<Import Project="..\Common\VersionInfo.props" />

	<PropertyGroup>
		<IsTestProject>true</IsTestProject>
		<EnableNUnitRunner>true</EnableNUnitRunner>
		<IsPackable>false</IsPackable>
		<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\SnowBank.Core\NetFxShim.cs" Link="NetFxShim.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- the Acme DCJS sample zoo: per-case metadata + the output captured from the real DataContractJsonSerializer -->
		<EmbeddedResource Include="Data\JSON\AcmeZoo\zoo.json" />
		<!-- Task 11: the stage-A Acme end-to-end simulation's back-office export stylesheet -->
		<EmbeddedResource Include="Xml\AcmeSimulation\account-export.xslt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
		<PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="NodaTime.Testing" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NUnit3TestAdapter">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="ZstdSharp.Port" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
		<!-- The CoreSDK is x64-only (the FoundationDB native client has no 32-bit build), so keep this
		     .NET Framework test-host executable 64-bit: the .NET test SDK otherwise defaults net4x test
		     hosts to win-x86. Only reached when CoreSdkNetStandardEnabled adds the net472 target. -->
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<!-- net472 is the ".NET Framework validation" target: it consumes the netstandard2.0 build of SnowBank.Core
		     and runs (a subset of) the test suite on the real .NET Framework CLR. -->
		<!-- HttpUtility (used as a reference implementation by the URL encoding tests) -->
		<Reference Include="System.Web" />
		<Reference Include="System.Net.Http" />
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
		<PackageReference Include="PolySharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
		<!-- direct reference so that the binding redirect to 2.2.3 is auto-generated (the NUnit adapter requests 2.1.0) -->
		<PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" />
		<!-- the System.Text.Json attributes ([JsonPropertyName], [JsonPolymorphic], ...) used by the test models are recognized by name on the netstandard2.0 build of SnowBank.Core -->
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SnowBank.Testing.Common\SnowBank.Testing.Common.csproj" />
		<ProjectReference Include="..\SnowBank.Core\SnowBank.Core.csproj" />
		<!-- analyzer only: generates the XML holders for the stage-A DCS-equivalence oracle suite (Xml/DcsProbes.cs) -->
		<ProjectReference Include="..\SnowBank.Serialization.Json.CodeGen\SnowBank.Serialization.Json.CodeGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
